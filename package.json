{
  "name": "keyboard-layer-editor",
  "private": true,
  "version": "0.1.0",
  "description": "Unofficial layer editor for FILCO keyboards that use FILCO Assist",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/svelte": "5.4.2",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "webdriverio": "10.1.0"
  }
}
